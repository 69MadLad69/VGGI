

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 texCoord;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat4 NormalMatrix;

varying vec3 vPosition;
varying vec2 vTexCoord;
varying vec3 vT;
varying vec3 vB;
varying vec3 vN;

void main() {
    vec4 posEye = ModelViewMatrix * vec4(vertex, 1.0);
    vPosition   = posEye.xyz;

    vTexCoord = texCoord;

    vec3 N = normalize((NormalMatrix * vec4(normal,  0.0)).xyz);
    vec3 T = normalize((NormalMatrix * vec4(tangent, 0.0)).xyz);

    vec3 B = normalize(cross(N, T));

    vT = T;
    vB = B;
    vN = N;

    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;


// Fragment shader
const fragmentShaderSource = `
precision mediump float;

uniform vec3 uLightPosition;
uniform vec3 uAmbient;
uniform vec3 uDiffuse;
uniform vec3 uSpecular;
uniform float uShininess;

uniform sampler2D uDiffuseMap;
uniform sampler2D uSpecularMap;
uniform sampler2D uNormalMap;

varying vec3 vPosition;
varying vec2 vTexCoord;
varying vec3 vT;
varying vec3 vB;
varying vec3 vN;

void main() {
    vec3 texDiff = texture2D(uDiffuseMap,  vTexCoord).rgb;
    vec3 texSpec = texture2D(uSpecularMap, vTexCoord).rgb;
    vec3 texNorm = texture2D(uNormalMap,   vTexCoord).rgb;

    vec3 N_tan = normalize(texNorm * 2.0 - 1.0);

    mat3 TBN = mat3(vT, vB, vN);

    vec3 N = normalize(TBN * N_tan);

    vec3 L = normalize(uLightPosition - vPosition);
    vec3 V = normalize(vec3(0.0, 0.0, 1.0)); // as per hint
    vec3 R = reflect(-L, N);

    float lambert = max(dot(N, L), 0.0);
    float spec    = pow(max(dot(R, V), 0.0), uShininess);

    vec3 ambient  = uAmbient * texDiff;
    vec3 diffuse  = uDiffuse * texDiff * lambert;
    vec3 specular = uSpecular * texSpec * spec;

    vec3 color = ambient + diffuse + specular;

    gl_FragColor = vec4(color, 1.0);
}
`;